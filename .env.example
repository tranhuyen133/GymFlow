# Sao chép thành .env rồi chỉnh giá trị. KHÔNG commit file .env
# Giá trị dưới chỉ dùng cho máy local. Đổi toàn bộ mật khẩu trước khi triển khai công khai.
MYSQL_DATABASE=gymflow
MYSQL_USER=gymflow
MYSQL_PASSWORD=gymflow_dev_password
MYSQL_ROOT_PASSWORD=root_dev_password
MYSQL_PORT=3307
BACKEND_PORT=8080
FRONTEND_PORT=8081
# Cổng web trên VPS khi chạy kèm compose.prod.yaml
PROD_FRONTEND_PORT=3000
# Cloudflare Tunnel (tuỳ chọn): token của tunnel, KHÔNG commit
TUNNEL_TOKEN=
# Chỉ cần khi gọi API từ một domain/cổng khác với giao diện (giao diện qua nginx dùng chung origin nên không cần)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# Tối thiểu 32 ký tự. Sinh ngẫu nhiên: openssl rand -base64 48
JWT_SECRET=change-me-please-use-at-least-32-characters-long
JWT_EXPIRATION_MINUTES=720
# Cho phép hội viên tự đăng ký tài khoản trên website
REGISTRATION_ENABLED=true
# Giới hạn đăng nhập 10 lần/phút, đăng ký và quên mật khẩu 5 lần/10 phút cho mỗi IP
RATE_LIMIT_ENABLED=true

# ---- Gửi email khôi phục mật khẩu qua Gmail SMTP ----
# 1. Bật xác thực 2 bước cho tài khoản Gmail.
# 2. Tạo App Password (Google Account > Security > App passwords).
# 3. Điền Gmail vào MAIL_USERNAME, App Password 16 ký tự (bỏ khoảng trắng) vào MAIL_PASSWORD.
# KHÔNG dùng mật khẩu Gmail thường và KHÔNG commit file .env.
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Có thể để trống để dùng MAIL_USERNAME
MAIL_FROM=
MAIL_FROM_NAME=GymFlow

# ---- Chế độ demo: mặc định TẮT (an toàn khi lỡ chép file này lên server) ----
# Máy local muốn có dữ liệu mẫu + nút đăng nhập nhanh: đổi SEED_DEMO_DATA và DEMO_QUICK_LOGIN thành true
# Tự sinh dữ liệu mẫu khi CSDL trống
SEED_DEMO_DATA=false
# Hiện nút đăng nhập nhanh bằng tài khoản demo
DEMO_QUICK_LOGIN=false
# Trả mã đặt lại mật khẩu trong response (dùng cho dev/demo khi MAIL_ENABLED=false)
RESET_EXPOSE_TOKEN=false
# Mật khẩu chung của các tài khoản mẫu khi SEED_DEMO_DATA=true. Để trống: tự sinh ngẫu nhiên mỗi lần khởi động
DEMO_PASSWORD=
